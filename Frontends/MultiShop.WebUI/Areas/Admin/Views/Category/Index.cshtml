@model List<MultiShop.DtoLayer.CatalogDtos.CategoryDtos.ResultCategoryDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>New Category Add</h4>
                <div class="bs-example" data-example-id="simple-table">
                    <table class="table">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Category Name</th>
                                <th>Category Product</th>
                                <th>Delete</th>
                                <th>Update</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model ?? new List<MultiShop.DtoLayer.CatalogDtos.CategoryDtos.ResultCategoryDto>())
                            {
                                <tr>
                                    <th scope="row">@item.CategoryId</th>
                                    <td>@item.CategoryName</td>
                                    <td><a href="#" class="btn btn-warning">Category Product</a></td>
                                    <td><a href="/Admin/Category/DeleteCategory/@item.CategoryId" class="btn btn-danger">Delete</a></td>
                                    <td><a href="/Admin/Category/UpdateCategory/@item.CategoryId" class="btn btn-success">Update</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <a href="/Admin/Category/CreateCategory" class="btn btn-success">New Category Add</a>
                </div>
            </div>
        </div>
       </div>
</section>

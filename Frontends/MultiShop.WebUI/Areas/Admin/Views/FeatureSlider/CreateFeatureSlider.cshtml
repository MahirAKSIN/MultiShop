@model MultiShop.DtoLayer.CatalogDtos.FeatureSliderDtos.CreateFeatureSliderDto

@{
    ViewData["Title"] = "CreateFeatureSliderDto";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                @if (ViewBag.error != null)
                {
                    <div class="alert alert-danger">@ViewBag.error</div>
                }
                <h4>Öne cıkanlar Gorseller Ekleme Girişi</h4>
                <p>For basic styling&mdash;light padding and only horizontal dividers&mdash</p>
                <div class="bs-example" data-example-id="simple-table">
                    <form method="post">
                        <label>Gorsel Başlığı</label>
                        <input type="text" class="form-control" name="Title" />
                        <br />
                        <label>Gorsel Acıklaması</label>
                        <input type="text" class="form-control" name="Description" />
                        <br />
                        <label>Gorsel linki</label>
                        <input type="text" class="form-control" name="ImageUrl" placeholder="ornek: carousel-1.jpg veya /online-shop-website-template/img/carousel-1.jpg" />
                        <small class="text-muted">wwwroot/online-shop-website-template/img altindaki dosya adi veya tam yol girin.</small>
                        <br />
                        <br />
                        <button type="submit" class="btn btn-primary">Öne cıkanlar Gorseller Girişi</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

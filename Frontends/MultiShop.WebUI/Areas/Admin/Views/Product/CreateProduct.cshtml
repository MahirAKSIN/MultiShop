@model MultiShop.DtoLayer.ProductsDtos.CreateProductDto

@{
    ViewData["Title"] = "CreateProduct";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var categories = ViewBag.categoryValue as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                @if (ViewBag.error != null)
                {
                    <div class="alert alert-danger">@ViewBag.error</div>
                }
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <h4>Add Product</h4>
                <div class="bs-example" data-example-id="simple-table">
                    <form method="post" asp-area="Admin" asp-controller="Product" asp-action="CreateProduct">
                        <label>Product Name</label>
                        <input type="text" class="form-control" asp-for="ProductName" required />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                        <br />
                        <label>Product Price</label>
                        <input type="number" step="0.01" class="form-control" asp-for="ProductPrice" />
                        <br />
                        <label>Product Image</label>
                        <input type="text" class="form-control" asp-for="ProductImageUrl" />
                        <br />
                        <label>Product Category</label>
                        <select asp-for="CategoryId" class="form-control" asp-items="categories" required>
                            <option value="">Kategori Seciniz</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                        <br />
                        <label>Product Description</label>
                        <textarea class="form-control" asp-for="ProductDescription" rows="5"></textarea>
                        <br />
                        <button type="submit" class="btn btn-primary">Add Product</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

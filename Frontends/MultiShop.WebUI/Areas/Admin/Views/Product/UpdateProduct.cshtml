@using MultiShop.DtoLayer.ProductsDtos
@model UpdateProductDto

@{
    ViewData["Title"] = "UpdateProduct";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var categories = ViewBag.categoryValue as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                @if (ViewBag.error != null)
                {
                    <div class="alert alert-danger">@ViewBag.error</div>
                }
                <h4>Update Product</h4>
                <div class="bs-example" data-example-id="simple-table">
                    <form method="post" asp-area="Admin" asp-controller="Product" asp-action="UpdateProduct" asp-route-id="@Model.ProductId">
                        <input type="hidden" name="ProductId" value="@Model.ProductId" />
                        <label>Product Id</label>
                        <input type="text" readonly class="form-control" value="@Model.ProductId" />
                        <br />
                        <label>Product Name</label>
                        <input type="text" class="form-control" name="ProductName" value="@Model.ProductName" />
                        <br />
                        <label>Product Price</label>
                        <input type="text" class="form-control" name="ProductPrice" value="@Model.ProductPrice" />
                        <br />
                        <label>Product Image</label>
                        <input type="text" class="form-control" name="ProductImageUrl" value="@Model.ProductImageUrl" />
                        <br />
                        <label>Product Category</label>
                        @Html.DropDownListFor(m => m.CategoryId, categories, "Kategori Seciniz", new { @class = "form-control" })
                        <br />
                        <label>Product Description</label>
                        <textarea class="form-control" name="ProductDescription" rows="5">@Model.ProductDescription</textarea>
                        <br />
                        <button type="submit" class="btn btn-primary">Update Product</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@model List<MultiShop.DtoLayer.CatalogDtos.FeatureSliderDtos.ResultFeatureSliderDto>
@{
    var sliders = Model ?? new List<MultiShop.DtoLayer.CatalogDtos.FeatureSliderDtos.ResultFeatureSliderDto>();
}

<div class="container-fluid mb-3">
    <div class="row px-xl-5">
        <div class="col-lg-8">
            <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-ride="carousel">
                <ol class="carousel-indicators">
                    @for (var i = 0; i < sliders.Count; i++)
                    {
                        <li data-target="#header-carousel" data-slide-to="@i" class="@(i == 0 ? "active" : null)"></li>
                    }
                </ol>
                <div class="carousel-inner">
                    @{
                        var index = 0;
                    }
                    @foreach (var item in sliders)
                    {
                        var imageUrl = (item.ImageUrl ?? string.Empty).Trim().Trim('"');
                        if (imageUrl.StartsWith("~/"))
                        {
                            imageUrl = Url.Content(imageUrl);
                        }

                        <div class="carousel-item position-relative @(index == 0 ? "active" : null)" style="height: 430px;">
                            <img class="position-absolute w-100 h-100" src="@imageUrl" style="object-fit: cover;" alt="@item.Title">
                            <div class="carousel-caption d-flex flex-column align-items-center justify-content-center">
                                <div class="p-3" style="max-width: 700px;">
                                    <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">@item.Title</h1>
                                    <p class="mx-md-5 px-5 animate__animated animate__bounceIn">@item.Description</p>
                                    <a class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp" href="#">Shop Now</a>
                                </div>
                            </div>
                        </div>
                        index++;
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            @await Component.InvokeAsync("_SpecialOfferComponentPartial")
        </div>
    </div>
</div>
